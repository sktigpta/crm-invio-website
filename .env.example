# ==============================================================================
# Invio CRM Website - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Backend API Endpoint for CRM management & staff authentication
# Development default: http://localhost:7496 or leave blank for proxy
# Production: https://api.invio.timrio.com
VITE_API_URL=https://api.invio.timrio.com

# Runtime environment flag: development => LOCAL API ONLY (same-origin /api proxy).
# `vite` (npm run dev) auto-loads .env.development which sets this to development.
VITE_APP_ENV=production

# Application Brand Metadata
VITE_APP_NAME=Invio CRM
# Optional version override. When unset, vite.config.js injects the version from
# package.json at build time (single source of truth — keep them in sync).
# VITE_APP_VERSION=1.0.2

# Google Sheets audit-log destination (public sheet ID only — never put a private key here)
VITE_GOOGLE_SHEET_ID=1Ojgd5-EQI6MCx-4YXXSwS779PF9sI87fPHoKKR2G6MU
